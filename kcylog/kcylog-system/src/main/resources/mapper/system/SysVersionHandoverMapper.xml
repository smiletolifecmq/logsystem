<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kcylog.system.mapper.SysVersionHandoverMapper">
    
    <resultMap type="SysVersionHandover" id="SysVersionHandoverResult">
        <result property="id"    column="id"    />
        <result property="ver"    column="ver"    />
        <result property="processId"    column="process_id"    />
        <result property="yjsj"    column="yjsj"    />
        <result property="sjsj"    column="sjsj"    />
        <result property="gzsj"    column="gzsj"    />
        <result property="yssj"    column="yssj"    />
        <result property="gdsj"    column="gdsj"    />
        <result property="bz"    column="bz"    />
    </resultMap>

    <sql id="selectSysVersionHandoverVo">
        select id, ver, process_id, yjsj, sjsj, gzsj, yssj, gdsj, bz from sys_version_handover
    </sql>

    <select id="selectSysVersionHandoverList" parameterType="SysVersionHandover" resultMap="SysVersionHandoverResult">
        <include refid="selectSysVersionHandoverVo"/>
        <where>  
            <if test="ver != null  and ver != ''"> and ver = #{ver}</if>
            <if test="processId != null "> and process_id = #{processId}</if>
            <if test="yjsj != null "> and yjsj = #{yjsj}</if>
            <if test="sjsj != null "> and sjsj = #{sjsj}</if>
            <if test="gzsj != null "> and gzsj = #{gzsj}</if>
            <if test="yssj != null "> and yssj = #{yssj}</if>
            <if test="gdsj != null "> and gdsj = #{gdsj}</if>
            <if test="bz != null  and bz != ''"> and bz = #{bz}</if>
        </where>
        order by ver asc
    </select>
    
    <select id="selectSysVersionHandoverById" parameterType="Long" resultMap="SysVersionHandoverResult">
        <include refid="selectSysVersionHandoverVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysVersionHandover" parameterType="SysVersionHandover" useGeneratedKeys="true" keyProperty="id">
        insert into sys_version_handover
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="ver != null and ver != ''">ver,</if>
            <if test="processId != null">process_id,</if>
            <if test="yjsj != null">yjsj,</if>
            <if test="sjsj != null">sjsj,</if>
            <if test="gzsj != null">gzsj,</if>
            <if test="yssj != null">yssj,</if>
            <if test="gdsj != null">gdsj,</if>
            <if test="bz != null">bz,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="ver != null and ver != ''">#{ver},</if>
            <if test="processId != null">#{processId},</if>
            <if test="yjsj != null">#{yjsj},</if>
            <if test="sjsj != null">#{sjsj},</if>
            <if test="gzsj != null">#{gzsj},</if>
            <if test="yssj != null">#{yssj},</if>
            <if test="gdsj != null">#{gdsj},</if>
            <if test="bz != null">#{bz},</if>
         </trim>
    </insert>

    <update id="updateSysVersionHandover" parameterType="SysVersionHandover">
        update sys_version_handover
        <trim prefix="SET" suffixOverrides=",">
            <if test="yjsj != null">yjsj = #{yjsj},</if>
            <if test="sjsj != null">sjsj = #{sjsj},</if>
            <if test="gzsj != null">gzsj = #{gzsj},</if>
            <if test="yssj != null">yssj = #{yssj},</if>
            <if test="gdsj != null">gdsj = #{gdsj},</if>
            <if test="bz != null">bz = #{bz},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysVersionHandoverById" parameterType="Long">
        delete from sys_version_handover where id = #{id}
    </delete>

    <delete id="deleteSysVersionHandoverByIds" parameterType="String">
        delete from sys_version_handover where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>