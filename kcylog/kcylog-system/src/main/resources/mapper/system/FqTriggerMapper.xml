<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kcylog.system.mapper.FqTriggerMapper">
    
    <resultMap type="FqTrigger" id="FqTriggerResult">
        <result property="id"    column="id"    />
        <result property="projectId"    column="project_id"    />
        <result property="opType"    column="op_type"    />
    </resultMap>

    <sql id="selectFqTriggerVo">
        select id, project_id, op_type from fq_trigger
    </sql>

    <select id="selectFqTriggerList" parameterType="FqTrigger" resultMap="FqTriggerResult">
        <include refid="selectFqTriggerVo"/>
        <where>  
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="opType != null  and opType != ''"> and op_type = #{opType}</if>
        </where>
    </select>
    
    <select id="selectFqTriggerById" parameterType="String" resultMap="FqTriggerResult">
        <include refid="selectFqTriggerVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertFqTrigger" parameterType="FqTrigger" useGeneratedKeys="true" keyProperty="id">
        insert into fq_trigger
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="opType != null">op_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="opType != null">#{opType},</if>
         </trim>
    </insert>

    <update id="updateFqTrigger" parameterType="FqTrigger">
        update fq_trigger
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectId != null">project_id = #{projectId},</if>
            <if test="opType != null">op_type = #{opType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteFqTriggerById" parameterType="String">
        delete from fq_trigger where id = #{id}
    </delete>

    <delete id="deleteFqTriggerByIds" parameterType="String">
        delete from fq_trigger where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>