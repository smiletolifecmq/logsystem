<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kcylog.system.mapper.SysGeoProjectMapper">
    
    <resultMap type="SysGeoProject" id="SysGeoProjectResult">
        <result property="projectId"    column="project_id"    />
        <result property="projectNum"    column="project_num"    />
        <result property="projectName"    column="project_name"    />
        <result property="userId"    column="user_id"    />
        <result property="userName"    column="user_name"    />
        <result property="oneCheck"    column="one_check"    />
        <result property="twoCheck"    column="two_check"    />
        <result property="money"    column="money"    />
        <result property="czDate"    column="cz_date"    />
    </resultMap>

    <sql id="selectSysGeoProjectVo">
        select project_id, project_num, project_name, user_id, user_name, one_check, two_check, money, cz_date from sys_geo_project
    </sql>

    <select id="selectSysGeoProjectList" parameterType="SysGeoProject" resultMap="SysGeoProjectResult">
        <include refid="selectSysGeoProjectVo"/>
        <where>  
            <if test="projectNum != null  and projectNum != ''"> and project_num = #{projectNum}</if>
            <if test="projectName != null  and projectName != ''"> and project_name like concat('%', #{projectName}, '%')</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="userName != null  and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
        </where>
        order by project_id desc 
    </select>
    
    <select id="selectSysGeoProjectByProjectId" parameterType="Long" resultMap="SysGeoProjectResult">
        <include refid="selectSysGeoProjectVo"/>
        where project_id = #{projectId}
    </select>
        
    <insert id="insertSysGeoProject" parameterType="SysGeoProject" useGeneratedKeys="true" keyProperty="projectId">
        insert into sys_geo_project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectNum != null and projectNum != ''">project_num,</if>
            <if test="projectName != null and projectName != ''">project_name,</if>
            <if test="userId != null">user_id,</if>
            <if test="oneCheck != null">one_check,</if>
            <if test="twoCheck != null">two_check,</if>
            <if test="userName != null and userName != ''">user_name,</if>
            <if test="money != null">money,</if>
            <if test="czDate != null">cz_date,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectNum != null and projectNum != ''">#{projectNum},</if>
            <if test="projectName != null and projectName != ''">#{projectName},</if>
            <if test="userId != null">#{userId},</if>
            <if test="oneCheck != null">#{oneCheck},</if>
            <if test="twoCheck != null">#{twoCheck},</if>
            <if test="userName != null and userName != ''">#{userName},</if>
            <if test="money != null">#{money},</if>
            <if test="czDate != null">#{czDate},</if>
         </trim>
    </insert>

    <update id="updateSysGeoProject" parameterType="SysGeoProject">
        update sys_geo_project
        <trim prefix="SET" suffixOverrides=",">
            <if test="projectNum != null and projectNum != ''">project_num = #{projectNum},</if>
            <if test="projectName != null and projectName != ''">project_name = #{projectName},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="oneCheck != null">one_check = #{oneCheck},</if>
            <if test="twoCheck != null">two_check = #{twoCheck},</if>
            <if test="userName != null and userName != ''">user_name = #{userName},</if>
            <if test="money != null">money = #{money},</if>
            <if test="czDate != null">cz_date = #{czDate},</if>
        </trim>
        where project_id = #{projectId}
    </update>

    <delete id="deleteSysGeoProjectByProjectId" parameterType="Long">
        delete from sys_geo_project where project_id = #{projectId}
    </delete>

    <delete id="deleteSysGeoProjectByProjectIds" parameterType="String">
        delete from sys_geo_project where project_id in 
        <foreach item="projectId" collection="array" open="(" separator="," close=")">
            #{projectId}
        </foreach>
    </delete>

    <select id="selectSysGeoProjectAll" parameterType="SysGeoLog" resultMap="SysGeoProjectResult">
        <include refid="selectSysGeoProjectVo"/>
        <where>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                AND date_format(cz_date,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                AND date_format(cz_date,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
        </where>
    </select>

    <select id="selectSysGeoProjectByProjectNum" parameterType="SysGeoProject" resultMap="SysGeoProjectResult">
        <include refid="selectSysGeoProjectVo"/>
        where project_num = #{projectNum}
    </select>

    <select id="selectSysGeoProjectByProjectNumNotSelf" parameterType="SysGeoProject" resultMap="SysGeoProjectResult">
        <include refid="selectSysGeoProjectVo"/>
        where project_num = #{projectNum} and project_id != #{projectId}
    </select>
</mapper>