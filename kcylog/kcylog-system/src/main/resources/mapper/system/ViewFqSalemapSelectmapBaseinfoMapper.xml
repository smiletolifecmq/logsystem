<mapper namespace="com.kcylog.system.mapper.ViewFqSalemapSelectmapBaseinfoMapper">
    
    <resultMap type="ViewFqSalemapSelectmapBaseinfo" id="ViewFqSalemapSelectmapBaseinfoResult">
        <result property="projectId"    column="project_id"    />
        <result property="mapScale"    column="map_scale"    />
    </resultMap>

    <sql id="selectViewFqSalemapSelectmapBaseinfoVo">
        select project_id, map_scale from view_fq_salemap_selectmap_baseinfo
    </sql>

    <select id="selectViewFqSalemapSelectmapBaseinfoList" parameterType="ViewFqSalemapSelectmapBaseinfo" resultMap="ViewFqSalemapSelectmapBaseinfoResult">
        <include refid="selectViewFqSalemapSelectmapBaseinfoVo"/>
        <where>  
            <if test="projectId != null "> and project_id = #{projectId}</if>
            <if test="mapScale != null "> and map_scale = #{mapScale}</if>
        </where>
    </select>
    
    <select id="selectViewFqSalemapSelectmapBaseinfoByProjectId" parameterType="Long" resultMap="ViewFqSalemapSelectmapBaseinfoResult">
        <include refid="selectViewFqSalemapSelectmapBaseinfoVo"/>
        where project_id = #{projectId} limit 1
    </select>
        
    <insert id="insertViewFqSalemapSelectmapBaseinfo" parameterType="ViewFqSalemapSelectmapBaseinfo">
        insert into view_fq_salemap_selectmap_baseinfo
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="projectId != null">project_id,</if>
            <if test="mapScale != null">map_scale,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="projectId != null">#{projectId},</if>
            <if test="mapScale != null">#{mapScale},</if>
         </trim>
    </insert>

    <update id="updateViewFqSalemapSelectmapBaseinfo" parameterType="ViewFqSalemapSelectmapBaseinfo">
        update view_fq_salemap_selectmap_baseinfo
        <trim prefix="SET" suffixOverrides=",">
            <if test="mapScale != null">map_scale = #{mapScale},</if>
        </trim>
        where project_id = #{projectId}
    </update>

    <delete id="deleteViewFqSalemapSelectmapBaseinfoByProjectId" parameterType="Long">
        delete from view_fq_salemap_selectmap_baseinfo where project_id = #{projectId}
    </delete>

    <delete id="deleteViewFqSalemapSelectmapBaseinfoByProjectIds" parameterType="String">
        delete from view_fq_salemap_selectmap_baseinfo where project_id in 
        <foreach item="projectId" collection="array" open="(" separator="," close=")">
            #{projectId}
        </foreach>
    </delete>
</mapper>