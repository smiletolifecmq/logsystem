<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kcylog.system.mapper.SysGeoNofundingProjectMapper">
    
    <resultMap type="SysGeoNofundingProject" id="SysGeoNofundingProjectResult">
        <result property="id"    column="id"    />
        <result property="createTime"    column="create_time"    />
        <result property="content"    column="content"    />
        <result property="client"    column="client"    />
        <result property="workload"    column="workload"    />
        <result property="fzr"    column="fzr"    />
        <result property="bz"    column="bz"    />
        <result property="tbsj"    column="tbsj"    />
        <result property="worknum"    column="worknum"    />
        <result property="lxr"    column="lxr"    />
    </resultMap>

    <sql id="selectSysGeoNofundingProjectVo">
        select id, create_time, content, client, workload, fzr, bz, tbsj, worknum, lxr from sys_geo_nofunding_project
    </sql>

    <select id="selectSysGeoNofundingProjectList" parameterType="SysGeoNofundingProject" resultMap="SysGeoNofundingProjectResult">
        <include refid="selectSysGeoNofundingProjectVo"/>
        <where>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                AND date_format(tbsj,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                AND date_format(tbsj,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="client != null  and client != ''"> and client = #{client}</if>
            <if test="workload != null  and workload != ''"> and workload = #{workload}</if>
            <if test="fzr != null  and fzr != ''"> and fzr = #{fzr}</if>
            <if test="bz != null  and bz != ''"> and bz = #{bz}</if>
        </where>
        order by id desc
    </select>
    
    <select id="selectSysGeoNofundingProjectById" parameterType="Long" resultMap="SysGeoNofundingProjectResult">
        <include refid="selectSysGeoNofundingProjectVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertSysGeoNofundingProject" parameterType="SysGeoNofundingProject" useGeneratedKeys="true" keyProperty="id">
        insert into sys_geo_nofunding_project
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createTime != null">create_time,</if>
            <if test="content != null">content,</if>
            <if test="client != null">client,</if>
            <if test="workload != null">workload,</if>
            <if test="fzr != null">fzr,</if>
            <if test="bz != null">bz,</if>
            <if test="tbsj != null">tbsj,</if>
            <if test="worknum != null">worknum,</if>
            <if test="lxr != null">lxr,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createTime != null">#{createTime},</if>
            <if test="content != null">#{content},</if>
            <if test="client != null">#{client},</if>
            <if test="workload != null">#{workload},</if>
            <if test="fzr != null">#{fzr},</if>
            <if test="bz != null">#{bz},</if>
            <if test="tbsj != null">#{tbsj},</if>
            <if test="worknum != null">#{worknum},</if>
            <if test="lxr != null">#{lxr},</if>
         </trim>
    </insert>

    <update id="updateSysGeoNofundingProject" parameterType="SysGeoNofundingProject">
        update sys_geo_nofunding_project
        <trim prefix="SET" suffixOverrides=",">
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="content != null">content = #{content},</if>
            <if test="client != null">client = #{client},</if>
            <if test="workload != null">workload = #{workload},</if>
            <if test="fzr != null">fzr = #{fzr},</if>
            <if test="bz != null">bz = #{bz},</if>
            <if test="tbsj != null">tbsj = #{tbsj},</if>
            <if test="worknum != null">worknum = #{worknum},</if>
            <if test="lxr != null">lxr = #{lxr},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysGeoNofundingProjectById" parameterType="Long">
        delete from sys_geo_nofunding_project where id = #{id}
    </delete>

    <delete id="deleteSysGeoNofundingProjectByIds" parameterType="String">
        delete from sys_geo_nofunding_project where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>